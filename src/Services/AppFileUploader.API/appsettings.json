{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationOptions": {
    "AppName": "",
    "AllowedHosts": "*",
    "ValidOrigin": "*",
    "InfraStructure": {
      "Mode": "OnPrem",
      "OnPrem": {
        "UploadPath": ""
      },
      "AzureBlob": {
        "BlobStorageConn": "",
        "BlobStorageContainer": ""
      }
    },
    "MySqlDb": {
      "Server": "",
      "User": "",
      "Password": "",
      "Database": "",
      "SSLMode": ""
    },
    "JwtConfig": {
      "Key": "",
      "Issuer": "",
      "Audience": ""
    },
    "OtlpEndpoint": ""
  },
  "ConnectionStrings": {    
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [ "Serilog.Enrichers.Environment" ],
    "Enrich": [ "WithMachineName", "WithThreadId", "WithEnvironmentUserName" ],
    "Properties": {
      "Application": "",
      "service.name": "",
      "service.version": ""
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <s:{SourceContext}>{NewLine}{Exception}"
        }
      },
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "",
          "ResourceAttributes": {
            "service.name": ""
          }
        }
      }
    ]
  }
}